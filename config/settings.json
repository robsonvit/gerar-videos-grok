{
  "video": {
    "target_duration_seconds": 10,
    "format": "mp4",
    "resolution": "720p",
    "aspect_ratio": "9:16",
    "orientation": "vertical",
    "fps": 30,
    "codec_video": "libx264",
    "codec_audio": "aac",
    "audio_bitrate": "128k",
    "video_bitrate": "2000k",
    "max_file_size_mb": 50
  },
  "audio": {
    "normalize": true,
    "target_loudness_lufs": -16,
    "true_peak_dbtp": -1.5,
    "loudness_range_lra": 11
  },
  "generation": {
    "service": "kie.ai",
    "base_url": "https://api.kie.ai",
    "model": "runway",
    "mode": "normal",
    "resolution": "720p",
    "duration_seconds": 5,
    "aspect_ratio": "9:16",
    "timeout_seconds": 300,
    "poll_interval_seconds": 5,
    "max_retries": 2,
    "retry_delay_seconds": 10
  },
  "tts": {
    "service": "fish_audio",
    "model": "s2.1-pro-free",
    "voice_id": "da20590a048f483986bf9986e6a87694",
    "fallback_service": "edge_tts",
    "fallback_voice": "pt-BR-FranciscaNeural"
  },
  "script": {
    "max_length_chars": 2500,
    "min_length_chars": 50,
    "validate_json": true
  },
  "telegram": {
    "parse_mode": "HTML",
    "disable_notification": false,
    "send_caption": true
  },
  "openrouter": {
    "base_url": "https://openrouter.ai/api/v1",
    "timeout_seconds": 35,
    "max_retries": 2,
    "retry_delay_seconds": 5
  },
  "output": {
    "scripts_dir": "output/scripts",
    "videos_dir": "output/videos",
    "audio_dir": "output/audio",
    "processed_dir": "output/processed",
    "logs_dir": "output/logs",
    "screenshots_dir": "output/screenshots"
  }
}
